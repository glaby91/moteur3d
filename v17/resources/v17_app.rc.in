#include <winver.h>
IDI_WARP_V17 ICON "@V17_ICON_RC_PATH@"

1 VERSIONINFO
 FILEVERSION 17,@V17_BUILD_NUMBER@,0,0
 PRODUCTVERSION 17,@V17_BUILD_NUMBER@,0,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904E4"
  BEGIN
   VALUE "CompanyName", "CSE WARP\0"
   VALUE "FileDescription", "CSE WARP Beta X V17.@V17_BUILD_NUMBER@ — Exploration 3D\0"
   VALUE "FileVersion", "17.@V17_BUILD_NUMBER@\0"
   VALUE "InternalName", "moteur3d_v17\0"
   VALUE "OriginalFilename", "moteur3d_v17.exe\0"
   VALUE "ProductName", "CSE WARP Beta X V17.@V17_BUILD_NUMBER@\0"
   VALUE "ProductVersion", "17.@V17_BUILD_NUMBER@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1252
 END
END
