# Small shared registry reader for the V16/V17 render module manifest.
# The manifest is the sole source of module revisions and source ownership.

function(m3d_validate_render_modules manifest repo_root)
    file(READ "${manifest}" _m3d_modules_json)
    string(JSON _m3d_schema ERROR_VARIABLE _m3d_json_error
           GET "${_m3d_modules_json}" schemaVersion)
    if(_m3d_json_error OR NOT _m3d_schema EQUAL 1)
        message(FATAL_ERROR "Unsupported render-module manifest: ${manifest}")
    endif()

    string(JSON _m3d_count LENGTH "${_m3d_modules_json}" modules)
    if(_m3d_count LESS 1)
        message(FATAL_ERROR "Render-module manifest is empty: ${manifest}")
    endif()

    set(_m3d_seen_ids)
    set(_m3d_seen_sources)
    math(EXPR _m3d_last "${_m3d_count} - 1")
    foreach(_m3d_index RANGE 0 ${_m3d_last})
        string(JSON _m3d_id GET "${_m3d_modules_json}" modules ${_m3d_index} id)
        string(JSON _m3d_revision GET "${_m3d_modules_json}" modules ${_m3d_index} revision)
        if(_m3d_id IN_LIST _m3d_seen_ids)
            message(FATAL_ERROR "Duplicate render-module id '${_m3d_id}'")
        endif()
        if(NOT _m3d_revision MATCHES "^[0-9][0-9][0-9]$")
            message(FATAL_ERROR "Module '${_m3d_id}' revision must be three digits")
        endif()
        list(APPEND _m3d_seen_ids "${_m3d_id}")

        string(JSON _m3d_source_count LENGTH "${_m3d_modules_json}" modules ${_m3d_index} sources)
        if(_m3d_source_count LESS 1)
            message(FATAL_ERROR "Module '${_m3d_id}' has no source files")
        endif()
        math(EXPR _m3d_source_last "${_m3d_source_count} - 1")
        foreach(_m3d_source_index RANGE 0 ${_m3d_source_last})
            string(JSON _m3d_source GET "${_m3d_modules_json}" modules ${_m3d_index} sources ${_m3d_source_index})
            if(NOT EXISTS "${repo_root}/${_m3d_source}")
                message(FATAL_ERROR "Module '${_m3d_id}' source is missing: ${_m3d_source}")
            endif()
            if(_m3d_source IN_LIST _m3d_seen_sources)
                message(FATAL_ERROR "Source '${_m3d_source}' is assigned to more than one render module")
            endif()
            list(APPEND _m3d_seen_sources "${_m3d_source}")
        endforeach()
    endforeach()
endfunction()

function(m3d_render_module_revision manifest module_id output_variable)
    file(READ "${manifest}" _m3d_modules_json)
    string(JSON _m3d_count LENGTH "${_m3d_modules_json}" modules)
    math(EXPR _m3d_last "${_m3d_count} - 1")
    foreach(_m3d_index RANGE 0 ${_m3d_last})
        string(JSON _m3d_id GET "${_m3d_modules_json}" modules ${_m3d_index} id)
        if(_m3d_id STREQUAL module_id)
            string(JSON _m3d_revision GET "${_m3d_modules_json}" modules ${_m3d_index} revision)
            set(${output_variable} "${_m3d_revision}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    message(FATAL_ERROR "Unknown render module '${module_id}' in ${manifest}")
endfunction()

function(m3d_render_module_source manifest module_id source_index repo_root output_variable)
    file(READ "${manifest}" _m3d_modules_json)
    string(JSON _m3d_count LENGTH "${_m3d_modules_json}" modules)
    math(EXPR _m3d_last "${_m3d_count} - 1")
    foreach(_m3d_index RANGE 0 ${_m3d_last})
        string(JSON _m3d_id GET "${_m3d_modules_json}" modules ${_m3d_index} id)
        if(_m3d_id STREQUAL module_id)
            string(JSON _m3d_source_count LENGTH "${_m3d_modules_json}" modules ${_m3d_index} sources)
            if(source_index LESS 0 OR source_index GREATER_EQUAL _m3d_source_count)
                message(FATAL_ERROR "Source index ${source_index} is invalid for module '${module_id}'")
            endif()
            string(JSON _m3d_source GET "${_m3d_modules_json}" modules ${_m3d_index} sources ${source_index})
            set(${output_variable} "${repo_root}/${_m3d_source}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    message(FATAL_ERROR "Unknown render module '${module_id}' in ${manifest}")
endfunction()

function(m3d_render_module_sources manifest engine repo_root output_variable)
    file(READ "${manifest}" _m3d_modules_json)
    string(JSON _m3d_count LENGTH "${_m3d_modules_json}" modules)
    set(_m3d_sources)
    math(EXPR _m3d_last "${_m3d_count} - 1")
    foreach(_m3d_index RANGE 0 ${_m3d_last})
        string(JSON _m3d_engine_count LENGTH "${_m3d_modules_json}" modules ${_m3d_index} engines)
        set(_m3d_enabled FALSE)
        if(_m3d_engine_count GREATER 0)
            math(EXPR _m3d_engine_last "${_m3d_engine_count} - 1")
            foreach(_m3d_engine_index RANGE 0 ${_m3d_engine_last})
                string(JSON _m3d_engine GET "${_m3d_modules_json}" modules ${_m3d_index} engines ${_m3d_engine_index})
                if(_m3d_engine STREQUAL engine)
                    set(_m3d_enabled TRUE)
                endif()
            endforeach()
        endif()
        if(NOT _m3d_enabled)
            continue()
        endif()
        string(JSON _m3d_optional GET "${_m3d_modules_json}" modules ${_m3d_index} optional)
        if(_m3d_optional)
            continue()
        endif()
        string(JSON _m3d_source_count LENGTH "${_m3d_modules_json}" modules ${_m3d_index} sources)
        math(EXPR _m3d_source_last "${_m3d_source_count} - 1")
        foreach(_m3d_source_index RANGE 0 ${_m3d_source_last})
            string(JSON _m3d_source GET "${_m3d_modules_json}" modules ${_m3d_index} sources ${_m3d_source_index})
            list(APPEND _m3d_sources "${repo_root}/${_m3d_source}")
        endforeach()
    endforeach()
    set(${output_variable} "${_m3d_sources}" PARENT_SCOPE)
endfunction()
